# Copy to .env in the project root for docker compose (and local server)

JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
MONGODB_URI=mongodb://localhost:27017/crud-node

# Comma-separated browser origins allowed for cookies + Socket.IO
CLIENT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Local Vite dev only (leave empty when using docker web on :8080 with nginx proxy)
VITE_API_URL=http://localhost:3000
